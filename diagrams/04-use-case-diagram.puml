@startuml Use Case Diagram - SmartBank Assistant
!theme plain
left to right direction

actor "Banking Customer" as User

rectangle "SmartBank Assistant System" {

  rectangle "Authentication & Authorization" {
    (Register Account) as UC1
    (Login to System) as UC2
    (Logout) as UC3
  }

  rectangle "Account Management" {
    (View All Accounts) as UC4
    (View Account Balance) as UC5
    (Create New Account) as UC6
    (View Account Details) as UC7
  }

  rectangle "Transaction Management" {
    (View Transaction History) as UC8
    (Create Deposit) as UC9
    (Create Withdrawal) as UC10
    (Create Transfer) as UC11
    (View Transaction Details) as UC12
  }

  rectangle "AI Chatbot Features" {
    (Send Chat Message) as UC13
    (View Chat History) as UC14
    (Get Account Balance via Chat) as UC15
    (Get Transaction Info via Chat) as UC16
    (Get Banking Product Info) as UC17
  }

  rectangle "Dashboard & Navigation" {
    (View Dashboard) as UC18
    (Navigate to Accounts) as UC19
    (Navigate to Transactions) as UC20
    (Navigate to Chat) as UC21
  }
}

